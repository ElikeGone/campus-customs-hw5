# Copy to .env (never commit .env) or set these in your shell before starting the backend.

# Required: Portkey gateway key. Every agent uses gpt-6-luna through Portkey only.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: browser origins allowed to call the FastAPI backend (comma-separated).
# Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
